root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,js,css}]
indent_size = 2

[*.{ps1,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Preserve upstream and generated animation data as distributed.
[native/vendor/**]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
